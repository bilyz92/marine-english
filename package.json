{
  "name": "marine-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "prisma generate && vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "prisma generate && vitest run --project integration",
    "typecheck": "prisma generate && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "oauth2-mock-server": "9.3.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.15 <25"
  }
}
