# Mẫu cấu hình production. Chép thành deploy/prod.env (quyền 600, không commit) rồi điền. Không để giá trị thật trong tệp này.
# Khóa 32 byte: openssl rand -base64 32. Danh sách khóa có phiên bản: "k1:<base64>,k2:<base64>".

APP_DOMAIN=
APP_ORIGIN=
IMAGE_TAG=

# Postgres: mật khẩu siêu quản trị (chỉ dùng tạo vai trò lúc đầu) và ba vai trò của hệ thống.
POSTGRES_PASSWORD=
ME_DB_NAME=marine_english
ME_MIGRATOR_PASSWORD=
ME_APP_PASSWORD=
ME_BACKUP_PASSWORD=

SESSION_KEY_LEARNER=
SESSION_KEY_ADMIN=
CSRF_KEY_LEARNER=
CSRF_KEY_ADMIN=
OIDC_STATE_KEY=
SESSION_ENC_KEYS=
SESSION_ENC_KEY_CURRENT=
OTP_PEPPERS=
OTP_PEPPER_CURRENT=
LICENSE_SIGNING_KEYS=
LICENSE_SIGNING_KID_CURRENT=
# Build arg, in ra bằng: pnpm cli license:public-keys
NEXT_PUBLIC_LICENSE_PUBLIC_KEYS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZALO_LOGIN_ENABLED=false

SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NO=
SEPAY_WEBHOOK_SECRETS=
CHECKOUT_BANK_NAME=
CHECKOUT_ACCOUNT_NAME=
CHECKOUT_QR_IMAGE=
CHECKOUT_TERMS_VERSION=

# Sao lưu: thư mục khóa trên máy chủ (mỗi khóa một tệp tên là mã khóa, ví dụ b2026a), khóa đang dùng, nơi lưu ngoài rclone (ví dụ remote:marine-english).
BACKUP_KEYS_HOST_DIR=
BACKUP_KEY_ID=
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG_HOST_DIR=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BUSINESS_CHAT_ID=
TELEGRAM_ERROR_CHAT_ID=
