generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Ràng buộc mà Prisma không diễn tả được (CHECK, index một phần, trigger, GRANT)
// nằm trong SQL viết tay ở cuối từng tệp migration.

model User {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termsAcceptances OrderTermsAcceptance[]
  refundRequests   Refund[] @relation("RefundRequestedByLearner")
  displayName      String             @map("display_name")
  rank             String?
  status           String             @default("active")
  mergedIntoId     String?            @map("merged_into_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  mergedInto       User?              @relation("UserMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom       User[]             @relation("UserMerge")
  identities       UserIdentity[]
  passwordLogin    PasswordLogin?
  devices          Device[]
  sessions         LearnerSession[]
  loginTickets     LoginTicket[]
  otpChallenges    OtpChallenge[]
  oidcStates       OidcState[]
  orders           Order[]
  enrollments      Enrollment[]
  learningEvents   LearningEvent[]
  learningProgress LearningProgress[]
  quizAttempts     QuizAttempt[]
  syncRejections   SyncRejection[]

  @@map("users")
}

model UserIdentity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  kind           String
  valueCanonical String   @map("value_canonical")
  verifiedAt     DateTime @map("verified_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([kind, valueCanonical])
  @@map("user_identities")
}

/// D2: số điện thoại + mật khẩu; số chưa xác minh, không phải danh tính đã xác minh. Duy nhất theo số giữa các dòng chưa nhả (index một phần trong migration).
model PasswordLogin {
  userId          String    @id @map("user_id") @db.Uuid
  phoneCanonical  String    @map("phone_canonical")
  passwordHash    String    @map("password_hash")
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(6)
  mustChange      Boolean   @default(false) @map("must_change")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_logins")
}

model PasswordAttempt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           String
  ip             String   @db.Inet
  phoneCanonical String?  @map("phone_canonical")
  ok             Boolean
  at             DateTime @default(now()) @db.Timestamptz(6)

  @@index([phoneCanonical, at])
  @@index([ip, at])
  @@map("password_attempts")
}

model Device {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  deviceKeyHash  String           @map("device_key_hash")
  label          String
  registeredAt   DateTime         @default(now()) @map("registered_at") @db.Timestamptz(6)
  lastSeenAt     DateTime?        @map("last_seen_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions       LearnerSession[]
  learningEvents LearningEvent[]
  syncRejections SyncRejection[]

  @@unique([userId, deviceKeyHash])
  @@map("devices")
}

model LearnerSession {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  deviceId          String                @map("device_id") @db.Uuid
  tokenHash         String                @unique @map("token_hash")
  tokenIssuedAt     DateTime              @default(now()) @map("token_issued_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  authAt            DateTime              @map("auth_at") @db.Timestamptz(6)
  lastSeenAt        DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime              @map("absolute_expires_at") @db.Timestamptz(6)
  prevValidUntil    DateTime?             @map("prev_valid_until") @db.Timestamptz(6)
  nextTokenEnc      String?               @map("next_token_enc")
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  device            Device                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  history           SessionTokenHistory[]

  @@map("learner_sessions")
}

model SessionTokenHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  tokenHash   String         @unique @map("token_hash")
  rotatedAt   DateTime       @default(now()) @map("rotated_at") @db.Timestamptz(6)
  detectUntil DateTime       @map("detect_until") @db.Timestamptz(6)
  session     LearnerSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, rotatedAt])
  @@map("session_token_history")
}

model LoginTicket {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  userId        String    @map("user_id") @db.Uuid
  realm         String    @default("learner")
  purpose       String    @default("replace_device")
  deviceKeyHash String    @map("device_key_hash")
  deviceLabel   String    @map("device_label")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("login_tickets")
}

model OtpChallenge {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose          String
  kind             String
  valueCanonical   String    @map("value_canonical")
  userId           String?   @map("user_id") @db.Uuid
  codeHmac         String    @map("code_hmac")
  keyVersion       String    @map("key_version")
  attempts         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt    DateTime? @map("invalidated_at") @db.Timestamptz(6)
  deliveryFailedAt DateTime? @map("delivery_failed_at") @db.Timestamptz(6)
  user             User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("otp_challenges")
}

model OtpSendLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           String
  valueCanonical String   @map("value_canonical")
  ip             String   @db.Inet
  channel        String
  sentAt         DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  outcome        String

  @@index([kind, valueCanonical, sentAt])
  @@index([ip, sentAt])
  @@map("otp_send_log")
}

model ZnsDailyBudget {
  day  DateTime @id @db.Date
  used Int      @default(0)

  @@map("zns_daily_budget")
}

model OidcState {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateHash     String    @unique @map("state_hash")
  realm         String
  intent        String
  userId        String?   @map("user_id") @db.Uuid
  nonce         String
  codeVerifier  String    @map("code_verifier")
  deviceKeyHash String?   @map("device_key_hash")
  deviceLabel   String?   @map("device_label")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("oidc_states")
}

model AdminUser {
  id                      String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailLower              String                        @unique @map("email_lower")
  role                    String
  status                  String
  invitedById             String?                       @map("invited_by") @db.Uuid
  invitedAt               DateTime                      @map("invited_at") @db.Timestamptz(6)
  inviteExpiresAt         DateTime                      @map("invite_expires_at") @db.Timestamptz(6)
  activatedAt             DateTime?                     @map("activated_at") @db.Timestamptz(6)
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  invitedBy               AdminUser?                    @relation("AdminInvite", fields: [invitedById], references: [id], onDelete: Restrict)
  invited                 AdminUser[]                   @relation("AdminInvite")
  identity                AdminIdentity?
  sessions                AdminSession[]
  emailLinks              AdminEmailLink[]
  auditEntries            AdminAuditLog[]
  enteredBankTransactions BankTransaction[]             @relation("BankTxEnteredBy")
  bankTxVerifications     BankTransactionVerification[] @relation("BankTxVerifiedBy")
  allocations             PaymentAllocation[]           @relation("AllocatedBy")
  dispositions            BankTransactionDisposition[]  @relation("DecidedBy")
  refundsRequested        Refund[]                      @relation("RefundRequestedBy")
  refundsApproved         Refund[]                      @relation("RefundApprovedBy")
  refundsSent             Refund[]                      @relation("RefundSentBy")
  refundsConfirmed        Refund[]                      @relation("RefundConfirmedBy")
  grants                  Enrollment[]                  @relation("GrantedBy")

  jobRequests JobRequest[]

  @@map("admin_users")
}

model AdminIdentity {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @unique @map("admin_user_id") @db.Uuid
  googleSub   String    @unique @map("google_sub")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@map("admin_identities")
}

model AdminSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId       String    @map("admin_user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  authAt            DateTime  @map("auth_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  adminUser         AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@map("admin_sessions")
}

model AdminEmailLink {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  adminUserId   String    @map("admin_user_id") @db.Uuid
  purpose       String    @default("login")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(6)
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@map("admin_email_links")
}

model AdminAuditLog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String?    @map("admin_user_id") @db.Uuid
  action      String
  targetType  String     @map("target_type")
  targetId    String?    @map("target_id")
  before      Json?
  after       Json?
  result      String
  reason      String?
  ip          String?    @db.Inet
  at          DateTime   @default(now()) @db.Timestamptz(6)
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([at])
  @@map("admin_audit_log")
}

// ===== Nội dung (migration content) =====

model Course {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String          @unique
  titleVi          String          @map("title_vi")
  titleEn          String          @map("title_en")
  status           String          @default("draft")
  priceVnd         Int?            @map("price_vnd")
  currentVersionId String?         @map("current_version_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  currentVersion   CourseVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions         CourseVersion[] @relation("CourseVersions")
  orderItems       OrderItem[]
  enrollments      Enrollment[]
  learningEvents   LearningEvent[]

  @@map("courses")
}

model CourseVersion {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId       String                @map("course_id") @db.Uuid
  version        Int
  contentVersion String                @map("content_version")
  sourceHash     String                @map("source_hash")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  course         Course                @relation("CourseVersions", fields: [courseId], references: [id], onDelete: Restrict)
  currentOf      Course[]              @relation("CurrentVersion")
  lessons        CourseVersionLesson[]
  orderItems     OrderItem[]

  @@unique([courseId, version])
  @@unique([courseId, sourceHash])
  @@map("course_versions")
}

model Lesson {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId   String             @unique @map("external_id")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  versions     LessonVersion[]
  progress     LearningProgress[]
  quizAttempts QuizAttempt[]

  @@map("lessons")
}

model LessonVersion {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId       String                @map("lesson_id") @db.Uuid
  version        Int
  content        Json
  contentHash    String                @map("content_hash")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  lesson         Lesson                @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  courses        CourseVersionLesson[]
  assets         LessonVersionAsset[]
  learningEvents LearningEvent[]

  @@unique([lessonId, version])
  @@unique([lessonId, contentHash])
  @@map("lesson_versions")
}

model CourseVersionLesson {
  courseVersionId String        @map("course_version_id") @db.Uuid
  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  position        Int
  isFreeTrial     Boolean       @map("is_free_trial")
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict)

  @@id([courseVersionId, position])
  @@unique([courseVersionId, lessonVersionId])
  @@map("course_version_lessons")
}

// ===== Tiền (migration money). CHECK, trigger, index một phần nằm trong SQL migration. =====

model Order {
  id                  String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termsAcceptance     OrderTermsAcceptance?
  code                String                          @unique(map: "orders_code_key")
  userId              String                          @map("user_id") @db.Uuid
  status              String                          @default("pending")
  amountDueVnd        Int                             @map("amount_due_vnd")
  currency            String                          @default("VND")
  refundPolicyVersion String                          @map("refund_policy_version")
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime                        @map("expires_at") @db.Timestamptz(6)
  paidAt              DateTime?                       @map("paid_at") @db.Timestamptz(6)
  expiredAt           DateTime?                       @map("expired_at") @db.Timestamptz(6)
  refundedAt          DateTime?                       @map("refunded_at") @db.Timestamptz(6)
  createdXact         Unsupported("xid8")             @default(dbgenerated("pg_current_xact_id()")) @map("created_xact")
  user                User                            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items               OrderItem[]
  classifications     BankTransactionClassification[]
  allocations         PaymentAllocation[]
  refunds             Refund[]
  enrollments         Enrollment[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  courseId        String        @map("course_id") @db.Uuid
  courseVersionId String        @map("course_version_id") @db.Uuid
  listPriceVnd    Int           @map("list_price_vnd")
  finalPriceVnd   Int           @map("final_price_vnd")
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orderId, courseId], map: "order_items_order_course_key")
  @@index([orderId])
  @@map("order_items")
}

model BankTransaction {
  id              String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankCode        String                          @map("bank_code")
  accountNo       String                          @map("account_no")
  bankRef         String                          @map("bank_ref")
  amountVnd       Int                             @map("amount_vnd")
  currency        String                          @default("VND")
  direction       String                          @default("in")
  content         String
  bankTime        DateTime                        @map("bank_time") @db.Timestamptz(6)
  receivedAt      DateTime                        @default(now()) @map("received_at") @db.Timestamptz(6)
  source          String
  enteredBy       String?                         @map("entered_by") @db.Uuid
  evidence        String?
  raw             Json?
  enteredByAdmin  AdminUser?                      @relation("BankTxEnteredBy", fields: [enteredBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  observations    BankTransactionObservation[]
  verifications   BankTransactionVerification[]
  classifications BankTransactionClassification[]
  allocation      PaymentAllocation?
  dispositions    BankTransactionDisposition[]
  refundSources   RefundSource[]

  @@unique([bankCode, accountNo, bankRef], map: "bank_transactions_identity_key")
  @@map("bank_transactions")
}

model BankTransactionObservation {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankTransactionId     String?                     @map("bank_transaction_id") @db.Uuid
  source                String
  providerEventId       String?                     @map("provider_event_id")
  payload               Json?
  receivedAt            DateTime                    @default(now()) @map("received_at") @db.Timestamptz(6)
  isFirst               Boolean                     @default(false) @map("is_first")
  mismatch              Boolean                     @default(false)
  ignoredReason         String?                     @map("ignored_reason")
  unresolvedReason      String?                     @map("unresolved_reason")
  resolvesObservationId String?                     @unique @map("resolves_observation_id") @db.Uuid
  bankTransaction       BankTransaction?            @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resolves              BankTransactionObservation? @relation("ObservationResolves", fields: [resolvesObservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resolvedBy            BankTransactionObservation? @relation("ObservationResolves")

  @@index([bankTransactionId], map: "observations_bank_transaction_id_idx")
  @@map("bank_transaction_observations")
}

model BankTransactionVerification {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankTransactionId String          @map("bank_transaction_id") @db.Uuid
  method            String
  verifiedBy        String?         @map("verified_by") @db.Uuid
  evidence          String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  verifier          AdminUser?      @relation("BankTxVerifiedBy", fields: [verifiedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([bankTransactionId], map: "verifications_bank_transaction_id_idx")
  @@map("bank_transaction_verifications")
}

model BankTransactionClassification {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankTransactionId String          @map("bank_transaction_id") @db.Uuid
  classifierVersion String          @map("classifier_version")
  result            String
  reason            String?
  candidateCodes    String[]        @map("candidate_codes")
  candidateOrderId  String?         @map("candidate_order_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  candidateOrder    Order?          @relation(fields: [candidateOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([bankTransactionId, createdAt], map: "classifications_bank_transaction_id_idx")
  @@map("bank_transaction_classifications")
}

model PaymentAllocation {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankTransactionId String          @unique @map("bank_transaction_id") @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  amountVnd         Int             @map("amount_vnd")
  kind              String
  allocatedBy       String?         @map("allocated_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocator         AdminUser?      @relation("AllocatedBy", fields: [allocatedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId], map: "allocations_order_id_idx")
  @@map("payment_allocations")
}

model BankTransactionDisposition {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankTransactionId String          @map("bank_transaction_id") @db.Uuid
  kind              String
  reason            String
  decidedBy         String          @map("decided_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  supersededAt      DateTime?       @map("superseded_at") @db.Timestamptz(6)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decider           AdminUser       @relation("DecidedBy", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("bank_transaction_dispositions")
}

model Refund {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String?        @map("order_id") @db.Uuid
  kind        String
  amountVnd   Int            @map("amount_vnd")
  status      String         @default("requested")
  reason      String
  outBankRef  String?        @unique @map("out_bank_ref")
  evidence    String?
  requestedBy String?        @map("requested_by") @db.Uuid
  approvedBy  String?        @map("approved_by") @db.Uuid
  sentBy      String?        @map("sent_by") @db.Uuid
  confirmedBy String?        @map("confirmed_by") @db.Uuid
  requestedAt DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt  DateTime?      @map("approved_at") @db.Timestamptz(6)
  sentAt      DateTime?      @map("sent_at") @db.Timestamptz(6)
  confirmedAt DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  closedAt    DateTime?      @map("closed_at") @db.Timestamptz(6)
  payoutBankName    String? @map("payout_bank_name")
  payoutAccountNo   String? @map("payout_account_no")
  payoutAccountName String? @map("payout_account_name")
  requestedByUser   String? @map("requested_by_user") @db.Uuid
  learner           User?   @relation("RefundRequestedByLearner", fields: [requestedByUser], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  requester   AdminUser?     @relation("RefundRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approver    AdminUser?     @relation("RefundApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sender      AdminUser?     @relation("RefundSentBy", fields: [sentBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  confirmer   AdminUser?     @relation("RefundConfirmedBy", fields: [confirmedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sources     RefundSource[]

  @@map("refunds")
}

model RefundSource {
  refundId          String          @map("refund_id") @db.Uuid
  bankTransactionId String          @map("bank_transaction_id") @db.Uuid
  amountVnd         Int             @map("amount_vnd")
  refund            Refund          @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([refundId, bankTransactionId])
  @@map("refund_sources")
}

model Enrollment {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  courseId      String     @map("course_id") @db.Uuid
  source        String
  orderId       String?    @map("order_id") @db.Uuid
  grantReason   String?    @map("grant_reason")
  grantedBy     String?    @map("granted_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt     DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?    @map("revoked_reason")
  user          User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order         Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  granter       AdminUser? @relation("GrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([orderId, courseId], map: "enrollments_order_course_key")
  @@index([userId, courseId], map: "enrollments_user_course_idx")
  @@map("enrollments")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupKey      String    @unique @map("dedup_key")
  kind          String
  channel       String
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  claimToken    String?   @map("claim_token") @db.Uuid
  claimedUntil  DateTime? @map("claimed_until") @db.Timestamptz(6)

  @@index([status, nextAttemptAt], map: "outbox_events_due_idx")
  @@map("outbox_events")
}

// ===== Học tập (migration learning) =====

model MediaAsset {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sha256         String
  mime           String
  bytes          Int
  visibility     String
  storageKey     String               @map("storage_key")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  lessonVersions LessonVersionAsset[]

  @@unique([visibility, storageKey], map: "media_assets_visibility_storage_key_key")
  @@map("media_assets")
}

model LessonVersionAsset {
  lessonVersionId String        @map("lesson_version_id") @db.Uuid
  mediaAssetId    String        @map("media_asset_id") @db.Uuid
  role            String
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  mediaAsset      MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([lessonVersionId, mediaAssetId])
  @@map("lesson_version_assets")
}

model LearningEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String         @unique @map("event_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  deviceId        String         @map("device_id") @db.Uuid
  seq             BigInt
  lessonVersionId String?        @map("lesson_version_id") @db.Uuid
  courseId        String?        @map("course_id") @db.Uuid
  type            String
  payload         Json
  payloadHash     String         @map("payload_hash")
  clientTime      DateTime?      @map("client_time") @db.Timestamptz(6)
  receivedAt      DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  entitlementOk   Boolean        @map("entitlement_ok")
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  device          Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lessonVersion   LessonVersion? @relation(fields: [lessonVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quizAttempt     QuizAttempt?

  @@unique([deviceId, seq], map: "learning_events_device_seq_key")
  @@index([userId])
  @@map("learning_events")
}

model LearningProgress {
  userId              String   @map("user_id") @db.Uuid
  lessonId            String   @map("lesson_id") @db.Uuid
  status              String
  completedActivities String[] @default([]) @map("completed_activities")
  bestScorePct        Int?     @map("best_score_pct")
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([userId, lessonId])
  @@map("learning_progress")
}

model QuizAttempt {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String        @unique @map("event_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  lessonId  String        @map("lesson_id") @db.Uuid
  scorePct  Int           @map("score_pct")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  event     LearningEvent @relation(fields: [eventId], references: [eventId], onDelete: Restrict, onUpdate: NoAction)

  @@map("quiz_attempts")
}

model SyncRejection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid
  reason    String
  raw       Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("sync_rejections")
}

// ===== Worker (migration jobs) =====

model JobLease {
  jobName    String   @id @map("job_name")
  token      String   @db.Uuid
  generation BigInt
  holder     String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("job_leases")
}

model JobRun {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobName    String       @map("job_name")
  startedAt  DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(6)
  status     String
  error      String?
  stats      Json?
  generation BigInt?
  requests   JobRequest[]

  @@index([jobName, startedAt(sort: Desc)], map: "job_runs_job_started_idx")
  @@map("job_runs")
}

model JobRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobName     String    @map("job_name")
  requestedBy String    @map("requested_by") @db.Uuid
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  pickedAt    DateTime? @map("picked_at") @db.Timestamptz(6)
  runId       String?   @map("run_id") @db.Uuid
  requester   AdminUser @relation(fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  run         JobRun?   @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("job_requests")
}

model ReconciliationCursor {
  provider             String
  bankCode             String   @map("bank_code")
  accountNo            String   @map("account_no")
  lastCompleteBankTime DateTime @map("last_complete_bank_time") @db.Timestamptz(6)
  lastCursorToken      String?  @map("last_cursor_token")
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([provider, bankCode, accountNo])
  @@map("reconciliation_cursors")
}

model OrderTermsAcceptance {
  orderId      String   @id @map("order_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  termsVersion String   @map("terms_version")
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("order_terms_acceptances")
}
